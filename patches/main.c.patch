 	init_platform();
 	xil_printf("[APP] init_platform done\r\n");
+	xil_printf("[REG] SLCR GEM0_CLK=%08x GEM0_RCLK=%08x\r\n",
+		   Xil_In32(0xF8000140U), Xil_In32(0xF8000144U));
+
+	/* Zynq-7000 MIO slew-rate fix for the GEM0 RGMII pin group.
+	 *
+	 * ps7_init programs MIO16..27 (ENET0 RGMII) with "fast" slew. The board
+	 * reference design uses "slow" slew. At 125 MHz DDR the fast setting
+	 * rings on the TX group (TXC/TX_CTL/TXD0..3) and the PHY samples corrupt
+	 * data, so frames leave the PHY with a bad FCS. RX is unaffected because
+	 * it is an input path, which is exactly the symptom seen on this board.
+	 *
+	 * MIO_PIN[8]: 1 = fast slew, 0 = slow slew.
+	 */
+	{
+		u32 i;
+
+		Xil_Out32(0xF8000008U, 0x0000DF0DU);	/* SLCR unlock */
+		for (i = 16U; i <= 27U; i++) {
+			u32 mio = 0xF8000700U + (4U * i);
+
+			Xil_Out32(mio, (Xil_In32(mio) & ~0x00000700U) | 0x00000400U);
+		}
+		Xil_Out32(0xF8000004U, 0x0000767BU);	/* SLCR lock */
+		xil_printf("[APP] GEM0 MIO16..27 slew=slow drive=12mA, MIO_PIN_16=%08x MIO_PIN_22=%08x\r\n",
+			   Xil_In32(0xF8000740U), Xil_In32(0xF8000758U));
+	}
 
