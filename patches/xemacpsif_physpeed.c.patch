 static void SetUpSLCRDivisors(XEmacPs *xemacpsp __attribute__((unused)),
                               s32_t speed __attribute__((unused)))
 {
+#ifdef SDT
+	/* The SDT build has no XPAR_PS7_ETHERNET_*_ENET_SLCR_* macros, so
+	 * the legacy divisor code below is compiled out. Zynq-7000 still
+	 * needs GEM0_CLK_CTRL updated when the PHY changes link speed; the
+	 * reset values from ps7_init are the 1000 Mbps setting. Leaving them
+	 * unchanged makes RGMII RX work while TX runs at the wrong clock.
+	 */
+	UINTPTR mac_baseaddr = xemacpsp->Config.BaseAddress;
+	u32_t gem_version = ((Xil_In32(mac_baseaddr + 0xFCU) >> 16) & 0xFFFU);
+	u32_t div0;
+	u32_t div1;
+	u32_t gem_clk_ctrl_addr;
+	u32_t gem_clk_ctrl;
+
+	if (gem_version == 2U) {
+		if (mac_baseaddr == ZYNQ_EMACPS_0_BASEADDR) {
+			gem_clk_ctrl_addr = SLCR_GEM0_CLK_CTRL_ADDR;
+		} else if (mac_baseaddr == ZYNQ_EMACPS_1_BASEADDR) {
+			gem_clk_ctrl_addr = SLCR_GEM1_CLK_CTRL_ADDR;
+		} else {
+			return;
+		}
+
+		/* Values match ps7_init / the legacy XPAR settings. */
+		if (speed == 1000) {
+			div0 = 8U;
+			div1 = 1U;
+		} else if (speed == 100) {
+			div0 = 8U;
+			div1 = 5U;
+		} else {
+			div0 = 8U;
+			div1 = 50U;
+		}
+
+		Xil_Out32(SLCR_UNLOCK_ADDR, SLCR_UNLOCK_KEY_VALUE);
+		gem_clk_ctrl = Xil_In32(gem_clk_ctrl_addr);
+		gem_clk_ctrl &= ~0x03F03F00U;
+		gem_clk_ctrl |= (div1 << 20) | (div0 << 8);
+		gem_clk_ctrl |= 0x00000001U;
+		Xil_Out32(gem_clk_ctrl_addr, gem_clk_ctrl);
+		Xil_Out32(SLCR_LOCK_ADDR, SLCR_LOCK_KEY_VALUE);
+
+		xil_printf("ZYNQ GEM0 clock speed=%d div0=%d div1=%d ctrl=%08x\r\n",
+			   (int)speed, (unsigned int)div0, (unsigned int)div1,
+			   (unsigned int)Xil_In32(gem_clk_ctrl_addr));
+	}
+	return;
+#endif
+
 #ifndef SDT
 	volatile UINTPTR slcrBaseAddress;
 	u32_t SlcrDiv0 = 0;
 	u32_t SlcrDiv1 = 0;
 	u32_t SlcrTxClkCntrl;
@@ -1488,5 +1725,7 @@ void MacConfig_SgmiiPcs(XEmacPs *xemacpsp, u32_t phy_addr) {
 		/* Write the updated value back to the PCS_CONTROL register */
 		XEmacPs_WriteReg(xemacpsp->Config.BaseAddress, XEMACPS_PCS_CONTROL_OFFSET, status);
 	}
 #endif
 }
