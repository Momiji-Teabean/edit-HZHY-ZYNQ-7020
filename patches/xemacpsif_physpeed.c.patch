+static void phy_yt8521_read_ext(XEmacPs *xemacpsp, u32_t phy_addr,
+				u16_t ext_addr, u16_t *ext_data)
+{
+	/* Same access sequence as Motorcomm's official Linux driver. The
+	 * address-offset register is intentionally left at the last accessed
+	 * extended register; writing it back to zero is not required and can
+	 * disturb subsequent standard MII register accesses.
+	 */
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, PHY_YT8521_EXT_ADDR_REG, ext_addr);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_YT8521_EXT_DATA_REG, ext_data);
+}
+
+static void phy_yt8521_write_ext(XEmacPs *xemacpsp, u32_t phy_addr,
+				 u16_t ext_addr, u16_t ext_data)
+{
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, PHY_YT8521_EXT_ADDR_REG, ext_addr);
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, PHY_YT8521_EXT_DATA_REG, ext_data);
+}
