 }
 
+static u32_t get_YT8521_phy_speed(XEmacPs *xemacpsp, u32_t phy_addr)
+{
+	u16_t control;
+	u16_t status;
+	u16_t status_speed;
+	u16_t id1 = 0;
+	u16_t id2 = 0;
+	u16_t rgmii_ctrl = 0;
+	u16_t rgmii_delay = 0;
+	u16_t page_sel = 0;
+	u16_t sleep_ctrl = 0;
+	u16_t rxclk = 0;
+	u16_t txdly_rd = 0;
+	u16_t txdly_after_an = 0;
+	u32_t timeout_counter = 0;
+	u32_t temp_speed;
+
+	xil_printf("Start YT8521 PHY autonegotiation\r\n");
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_IDENTIFIER_1_REG, &id1);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_IDENTIFIER_2_REG, &id2);
+
+	/* Reset the PHY so all vendor registers return to their hardware
+	 * strap defaults before applying the official YT8521 init sequence.
+	 */
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, IEEE_CONTROL_REG_OFFSET, 0x8000U);
+	for (timeout_counter = 0; timeout_counter < 100000U; timeout_counter++) {
+		XEmacPs_PhyRead(xemacpsp, phy_addr, IEEE_CONTROL_REG_OFFSET, &control);
+		if ((control & 0x8000U) == 0U) {
+			break;
+		}
+	}
+	xil_printf("YT8521 PHY reset done, BMCR=%04x\r\n", control);
+
+	/* YT8521 has two extended register banks: UTP (copper) and fiber/
+	 * SerDes, selected by 0xA000. The UTP page must be active before the
+	 * RGMII control/delay registers are touched.
+	 */
+	phy_yt8521_write_ext(xemacpsp, phy_addr, PHY_YT8521_UTP_PAGE_REG,
+			     0x0000U);
+
+	/* Official YT8521 initialisation steps taken from the Motorcomm driver. */
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_SLEEP_CTRL_REG, &sleep_ctrl);
+	sleep_ctrl &= (u16_t)~0x8000U;	/* bit15: disable auto-sleep */
+	phy_yt8521_write_ext(xemacpsp, phy_addr, PHY_YT8521_SLEEP_CTRL_REG, sleep_ctrl);
+
+	/* Official YT8521 init: keep RXC clock enabled; do not modify TX delay. */
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_RXC_CLK_REG, &rxclk);
+	rxclk &= (u16_t)~0x1000U;
+	phy_yt8521_write_ext(xemacpsp, phy_addr, PHY_YT8521_RXC_CLK_REG, rxclk);
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_RXC_CLK_REG, &txdly_rd);
+	xil_printf("YT8521 sleep=%04x rxc_clk=%04x tx_dly_readback=%04x\r\n",
+		   sleep_ctrl, rxclk, txdly_rd);
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_UTP_PAGE_REG,
+			    &page_sel);
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_RGMII_CTRL_REG,
+			    &rgmii_ctrl);
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_RGMII_DELAY_REG,
+			    &rgmii_delay);
+	rgmii_delay = 0x00FDU; /* MIO 12mA: 1000M TX delay 13*150ps=1.95ns. */
+	phy_yt8521_write_ext(xemacpsp, phy_addr, PHY_YT8521_RGMII_DELAY_REG, rgmii_delay);
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_STS, &status_speed);
+	xil_printf("YT8521 ID1=%04x ID2=%04x A000=%04x A001=%04x A003=%04x REG11=%04x\r\n",
+		   id1, id2, page_sel, rgmii_ctrl, rgmii_delay, status_speed);	/* Official YT8521 init leaves A001/A003 at their hardware strap values. */
+	xil_printf("YT8521 RGMII registers: A001=%04x A003=%04x\r\n",
+		   rgmii_ctrl, rgmii_delay);
+
+	/* Advertise all supported copper speeds and pause capability. */
+	XEmacPs_PhyRead(xemacpsp, phy_addr, IEEE_AUTONEGO_ADVERTISE_REG, &control);
+	control |= IEEE_ASYMMETRIC_PAUSE_MASK;
+	control |= IEEE_PAUSE_MASK;
+	control |= ADVERTISE_100;
+	control |= ADVERTISE_10;
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, IEEE_AUTONEGO_ADVERTISE_REG, control);
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, IEEE_1000_ADVERTISE_REG_OFFSET,
+			&control);
+	control |= ADVERTISE_1000;
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, IEEE_1000_ADVERTISE_REG_OFFSET,
+			 control);
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, IEEE_CONTROL_REG_OFFSET, &control);
+	control |= IEEE_CTRL_AUTONEGOTIATE_ENABLE;
+	control |= IEEE_STAT_AUTONEGOTIATE_RESTART;
+	XEmacPs_PhyWrite(xemacpsp, phy_addr, IEEE_CONTROL_REG_OFFSET, control);
+
+	XEmacPs_PhyRead(xemacpsp, phy_addr, IEEE_STATUS_REG_OFFSET, &status);
+	xil_printf("Waiting for YT8521 autonegotiation.\r\n");
+
+	while (!(status & IEEE_STAT_AUTONEGOTIATE_COMPLETE)) {
+		sleep(1);
+		XEmacPs_PhyRead(xemacpsp, phy_addr, IEEE_STATUS_REG_OFFSET,
+				&status);
+		timeout_counter++;
+		if (timeout_counter >= 30U) {
+			xil_printf("YT8521 auto negotiation timeout, BMSR=%04x\r\n", status);
+			return XST_FAILURE;
+		}
+	}
+	xil_printf("YT8521 autonegotiation complete, BMSR=%04x\r\n", status);
+
+	phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_RGMII_DELAY_REG, &txdly_after_an);
+	xil_printf("YT8521 A003 after AN=%04x\r\n", txdly_after_an);
+	if (txdly_after_an != rgmii_delay) {
+		phy_yt8521_write_ext(xemacpsp, phy_addr, PHY_YT8521_RGMII_DELAY_REG, rgmii_delay);
+		phy_yt8521_read_ext(xemacpsp, phy_addr, PHY_YT8521_RGMII_DELAY_REG, &txdly_after_an);
+		xil_printf("YT8521 A003 restored=%04x\r\n", txdly_after_an);
+	}
+	XEmacPs_PhyRead(xemacpsp, phy_addr, PHY_STS, &status_speed);
+	xil_printf("YT8521 REG11 after AN=%04x\r\n", status_speed);
+	/* YT8521 packet generator diagnostic */
+	{
+		u16_t pkg_cfg_before = 0;
+		u16_t pkg_cfg_stop = 0;
+		phy_yt8521_read_ext(xemacpsp, phy_addr, 0xA0U, &pkg_cfg_before);
+		phy_yt8521_write_ext(xemacpsp, phy_addr, 0xA1U, 0x0040U);
+		phy_yt8521_write_ext(xemacpsp, phy_addr, 0xA2U, 0x0000U);
+		phy_yt8521_write_ext(xemacpsp, phy_addr, 0xA0U, 0x18D0U);
+		xil_printf("YT8521 PKG generator ON A0before=%04x\r\n", pkg_cfg_before);
+		sleep(2);
+		phy_yt8521_write_ext(xemacpsp, phy_addr, 0xA0U,
+				     (u16_t)((pkg_cfg_before & (u16_t)~0x1000U) | 0x6000U));
+		phy_yt8521_read_ext(xemacpsp, phy_addr, 0xA0U, &pkg_cfg_stop);
+		phy_yt8521_write_ext(xemacpsp, phy_addr, 0xA0U, pkg_cfg_before);
+		xil_printf("YT8521 PKG generator OFF A0stop=%04x restored=%04x\r\n",
+			   pkg_cfg_stop, pkg_cfg_before);
+	}
+	if ((status_speed & 0x0400U) == 0U) {
+		xil_printf("YT8521 reports link down in REG11.\r\n");
+	}
+
+	temp_speed = status_speed & 0xC000U;
+	if (temp_speed == 0x8000U) {
+		return 1000;
+	} else if (temp_speed == 0x4000U) {
+		return 100;
+	} else {
+		return 10;
+	}
+}
